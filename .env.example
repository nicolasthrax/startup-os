# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=sk-or-v1-...

# Per-venture deploy credentials for `startup-os build` (replace HELLO with the
# venture slug, upper-cased, dashes → underscores). Scope each token to the
# venture's own project. They are passed only to our deploy/migrate steps as env
# vars, never to Claude Code and never into a prompt.
# VENTURE_HELLO_VERCEL_TOKEN=
# VENTURE_HELLO_VERCEL_ORG_ID=
# VENTURE_HELLO_VERCEL_PROJECT_ID=
# VENTURE_HELLO_PROD_URL=https://hello.vercel.app
# VENTURE_HELLO_SUPABASE_STAGING_DB_URL=postgresql://...   # free "staging" project
# VENTURE_HELLO_SUPABASE_PROD_DB_URL=postgresql://...      # prod project
